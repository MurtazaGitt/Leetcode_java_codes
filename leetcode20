Stack<Character> st = new Stack<>();
        int n = s.length();

        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);

            // Push opening brackets to the stack
            if (c == '(' || c == '{' || c == '[') {
                st.push(c);
            } else {
                // Ensure the stack is not empty and match the top of the stack with the current closing bracket
                if (st.isEmpty()) {
                    return false; // No matching opening bracket for this closing bracket
                }
                char top = st.pop();

                if ((c == ')' && top != '(') ||
                    (c == '}' && top != '{') ||
                    (c == ']' && top != '[')) {
                    return false; // Mismatch between opening and closing brackets
                }
            }
        }

        // Return true if the stack is empty, meaning all brackets were matched
        return st.isEmpty();