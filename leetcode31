  int n=nums.length;
       int bp=-1;
       int bp2=-1;
       for(int i=n-2;i>=0;i--)
       {
        if(nums[i]<nums[i+1])
        {
            bp=i;
            break;
        }
       }
       if(bp==-1)
       {
        reverse(nums,0,n-1);
       }
       else{
              for(int i=n-1;i>=0;i--){
                   if(nums[i]>nums[bp]){
                    bp2=i;
                    break;
                   }
              }
              swap(nums,bp,bp2);
               reverse(nums,bp+1,n-1);
       }
    }
    void swap(int nums[],int i, int j)
    {
        int temp=nums[i];
        nums[i]=nums[j];
        nums[j]=temp;
    }
    void reverse(int nums[],int low,int high)
    {
        while(high>=low)
        {
             int temp=nums[low];
        nums[low]=nums[high];
        nums[high]=temp;
        low++;
        high--;
        }